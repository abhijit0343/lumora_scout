# Application environment (development | staging | production)
APP_ENV=development
# Application name
APP_NAME=lumora-scout
# API server host bind address
API_HOST=0.0.0.0
# API server port
API_PORT=8000
# Allowed CORS origins
CORS_ORIGINS=http://localhost:5173
# Application logging level
LOG_LEVEL=INFO

# Primary LLM API key for Google Gemini
GEMINI_API_KEY=
# Primary LLM provider name
LLM_PRIMARY_PROVIDER=gemini
# Primary LLM model identifier
LLM_PRIMARY_MODEL=gemini-3.8-flash
# Default thinking level for reasoning-capable models (low | medium | high)
LLM_THINKING_LEVEL_DEFAULT=medium
# Thinking level for router classification prompt
LLM_THINKING_LEVEL_ROUTER=low
# Thinking level for safety guardrail classification
LLM_THINKING_LEVEL_GUARD=low
# Thinking level for capability extraction
LLM_THINKING_LEVEL_EXTRACT=medium
# Thinking level for final verdict synthesis
LLM_THINKING_LEVEL_VERDICT=high
# Maximum tokens in LLM generation response
LLM_MAX_OUTPUT_TOKENS=8192
# LLM client HTTP call timeout in seconds
LLM_TIMEOUT_S=60
# Maximum retry attempts on LLM call failure or rate limit
LLM_MAX_RETRIES=3

# Fallback chain (tried in order when the primary fails or is rate-limited)
# Enable automatic fallback chain across secondary providers
LLM_FALLBACK_ENABLED=true
# Comma-separated order of fallback providers to try
LLM_FALLBACK_CHAIN=groq,openrouter,ollama
# Groq Cloud API key
GROQ_API_KEY=
# Groq OpenAI-compatible base URL endpoint
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Groq model identifier (verify on Groq's models page)
GROQ_MODEL=llama-3.3-70b-versatile
# OpenRouter API key
OPENROUTER_API_KEY=
# OpenRouter OpenAI-compatible base URL endpoint
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter model identifier (choose a ":free" model with tool support)
OPENROUTER_MODEL=
# Ollama local daemon base URL endpoint
OLLAMA_BASE_URL=http://localhost:11434
# Ollama local model tag identifier
OLLAMA_MODEL=qwen2.5:7b

# Embeddings (EmbeddingGemma 2)
# Hugging Face access token (optional; needed if the model repo requires it)
HF_TOKEN=
# Text embedding model identifier on Hugging Face Hub
EMBEDDING_MODEL=google/embeddinggemma-2
# Active embedding modalities (text | text,image - load only what is needed)
EMBEDDING_MODALITIES=text
# Embedding vector dimension (verify on model card)
EMBEDDING_DIM=768
# Maximum input token sequence length for embedding model
EMBEDDING_MAX_TOKENS=8192
# Execution device for embedding inference (cpu | cuda | mps)
EMBEDDING_DEVICE=cpu
# Flag to enable cross-encoder reranking stage
RERANKER_ENABLED=false
# Cross-encoder reranker model identifier on Hugging Face Hub
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# RAG
# Target text chunk character or token size
CHUNK_SIZE=600
# Chunk overlap character or token size
CHUNK_OVERLAP=100
# Number of top candidate chunks retrieved during hybrid search
RETRIEVE_TOP_K=8
# Hybrid retrieval weighting factor for dense vs sparse scores (0.0 to 1.0)
HYBRID_DENSE_WEIGHT=0.6
# Method for aggregating chunk similarities into product score (topk_mean | max | weighted)
SIMILARITY_AGGREGATION=topk_mean
# Top-K chunks considered during similarity score aggregation
SIMILARITY_TOP_K=5
# Maximum allowed uploaded document file size in megabytes
MAX_UPLOAD_MB=15
# Comma-separated allowed file extensions for document ingestion
ALLOWED_UPLOAD_TYPES=pdf,docx,txt,md
# Filesystem path to serialized FAISS vector indexes
FAISS_INDEX_DIR=./data/indexes

# Search and data tools
# Tavily Search API key for web research
TAVILY_API_KEY=
# Brave Search API key for web retrieval
BRAVE_API_KEY=
# The Movie Database (TMDB) API key
TMDB_API_KEY=
# Open Movie Database (OMDb) API key
OMDB_API_KEY=
# YouTube Data API v3 key
YOUTUBE_API_KEY=
# GitHub personal access token for repository data
GITHUB_TOKEN=
# Time-to-live cache duration in seconds for search and API tool results
SEARCH_CACHE_TTL_S=86400

# Guardrails
# Master toggle to enable all 4 layers of safety guardrails
GUARDRAILS_ENABLED=true
# Fast classifier model identifier for guardrail checks
GUARD_CLASSIFIER_MODEL=gemini-3.8-flash
# Google Safe Browsing API key for URL reputation screening
SAFE_BROWSING_API_KEY=
# Path to directory containing custom domain/URL blocklists
BLOCKLIST_DIR=./data/blocklists
# Action taken when guardrail evaluation is uncertain (ask | block)
GUARD_UNCERTAIN_ACTION=ask
# Filter adult content from TMDB tool queries
TMDB_INCLUDE_ADULT=false
# Maximum allowable content certification rating for media queries
MAX_CONTENT_CERTIFICATION=PG-13
# Timeout in seconds for web page fetching
FETCH_TIMEOUT_S=15
# Maximum allowable raw web page response size in bytes
MAX_PAGE_BYTES=2000000
# Allow headless Playwright fallback when static HTTP extraction fails
ALLOW_PLAYWRIGHT_FALLBACK=true
# Block requests resolving to private, local, or link-local IP addresses (SSRF guard)
SSRF_BLOCK_PRIVATE_RANGES=true

# Agent, HITL, streaming
# SQLite database path for LangGraph checkpoints and thread state
CHECKPOINT_DB_PATH=./data/checkpoints.sqlite
# Require human-in-the-loop confirmation before fetching resolved comparison targets
HITL_CONFIRM_TARGETS=true
# Require human-in-the-loop confirmation of comparison criteria before scoring
HITL_CONFIRM_CRITERIA=false
# Time-to-live expiration in minutes for pending human interrupt checkpoints
INTERRUPT_TTL_MIN=30
# Maximum query rewrite retry loops when retrieval grading fails
MAX_REWRITE_LOOPS=2
# Interval in seconds between Server-Sent Events (SSE) keep-alive heartbeat comments
SSE_HEARTBEAT_S=15

# Observability and limits
# Enable LangSmith agent run tracing
LANGSMITH_TRACING=false
# LangSmith platform API key
LANGSMITH_API_KEY=
# LangSmith project name for trace grouping
LANGSMITH_PROJECT=lumora-scout
# API endpoint request rate limit per client IP per minute
RATE_LIMIT_PER_MIN=30
